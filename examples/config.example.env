# J.A.R.V.I.S. example configuration
# Copy to a private .env file. Never commit real values.

APP_VERSION=3.5.3

# Primary and ordered fallback candidates.
DEFAULT_PROVIDER=groq/openai/gpt-oss-120b
FALLBACK_PROVIDERS=openrouter,zen-nemotron-3-ultra-free

# Provider configuration placeholders.
GROQ_API_KEY=replace_with_a_private_key
OPENROUTER_API_KEY=replace_with_a_private_key
OPENCODE_API_KEY=replace_with_a_private_key
# GEMINI_API_KEY=replace_with_a_private_key
# DEEPSEEK_API_KEY=replace_with_a_private_key
# KIMI_API_KEY=replace_with_a_private_key
# ANTHROPIC_API_KEY=replace_with_a_private_key

# Optional local provider.
OLLAMA_BASE_URL=http://<loopback-host>:11434
# LOCAL_MODEL_PATH=<private-data-directory>/model.gguf

# Web interface.
JARVIS_WEB_TOKEN=replace_with_a_private_token
# Bind only to loopback for a personal deployment.
WEB_HOST=<loopback-host>
WEB_PORT=8000

# Telegram interface.
TELEGRAM_BOT_TOKEN=replace_with_a_private_bot_token
TELEGRAM_ALLOWED_USERS=

# Reliability settings.
PROVIDER_COOLDOWN=300
FIRST_CHUNK_TIMEOUT=30

# Memory and search defaults.
MEMORY_DB_PATH=<private-data-directory>/memory.db
MEMORY_MAX_CONTEXT=5
SEARCH_CACHE_TTL=600
SEARCH_MAX_RESULTS=5

# Do not commit this file with real credentials.
# .env is intentionally excluded from the public case study.
